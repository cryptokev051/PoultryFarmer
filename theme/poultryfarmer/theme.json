{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Warm White",
          "color": "#F6F4EC"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#FFFFFF"
        },
        {
          "slug": "footer-muted",
          "name": "Footer Muted",
          "color": "#D5E2DD"
        },
        {
          "slug": "foreground",
          "name": "Charcoal",
          "color": "#283A3B"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5B6B6B"
        },
        {
          "slug": "brand",
          "name": "Forest Green",
          "color": "#123B37"
        },
        {
          "slug": "brand-dark",
          "name": "Forest Green Dark",
          "color": "#123B37"
        },
        {
          "slug": "brand-soft",
          "name": "Warm White Soft",
          "color": "#F6F4EC"
        },
        {
          "slug": "harvest-gold",
          "name": "Harvest Gold",
          "color": "#E9B85B"
        },
        {
          "slug": "divider",
          "name": "Divider",
          "color": "#D8DFD8"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#2F7D4A"
        },
        {
          "slug": "warning",
          "name": "Warning",
          "color": "#A15C00"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {"slug": "10", "size": "0.25rem", "name": "4px"},
        {"slug": "20", "size": "0.5rem", "name": "8px"},
        {"slug": "30", "size": "0.75rem", "name": "12px"},
        {"slug": "40", "size": "1rem", "name": "16px"},
        {"slug": "50", "size": "1.5rem", "name": "24px"},
        {"slug": "60", "size": "2rem", "name": "32px"},
        {"slug": "70", "size": "3rem", "name": "48px"},
        {"slug": "80", "size": "4rem", "name": "64px"},
        {"slug": "90", "size": "6rem", "name": "96px"}
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Arial, sans-serif"
        },
        {
          "slug": "editorial",
          "name": "Editorial Serif",
          "fontFamily": "Georgia, \"Times New Roman\", serif"
        }
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.875rem", "name": "Small"},
        {"slug": "medium", "size": "1rem", "name": "Medium"},
        {"slug": "large", "size": "1.25rem", "name": "Large"},
        {"slug": "x-large", "size": "clamp(1.75rem, 3vw, 2.5rem)", "name": "Extra Large"},
        {"slug": "xx-large", "size": "clamp(2.25rem, 5vw, 4.25rem)", "name": "Display"}
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "name": "Card",
          "shadow": "0 12px 32px rgba(18, 59, 55, 0.1)"
        }
      ]
    },
    "custom": {
      "radius": {
        "small": "8px",
        "medium": "14px",
        "large": "22px",
        "pill": "999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|foreground"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "left": "clamp(18px, 3vw, 32px)",
        "right": "clamp(18px, 3vw, 32px)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "color": {"text": "var:preset|color|foreground"},
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "700",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": {"text": "var:preset|color|brand-dark"},
        "typography": {"textDecoration": "underline"},
        ":hover": {
          "color": {"text": "var:preset|color|brand-dark"},
          "typography": {"textDecoration": "none"}
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|brand",
          "text": "var:preset|color|surface"
        },
        "border": {"radius": "10px"},
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "right": "1.2rem",
            "bottom": "0.8rem",
            "left": "1.2rem"
          }
        },
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "750",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|harvest-gold",
            "text": "var:preset|color|brand-dark"
          }
        }
      },
      "caption": {
        "color": {"text": "var:preset|color|muted"},
        "typography": {"fontSize": "0.875rem"}
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.5rem",
          "fontWeight": "800",
          "letterSpacing": "-0.03em"
        },
        "elements": {
          "link": {
            "color": {"text": "var:preset|color|brand-dark"},
            "typography": {"textDecoration": "none"}
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.95rem",
          "fontWeight": "650"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {"text": "var:preset|color|foreground"},
            "typography": {"textDecoration": "none"},
            ":hover": {"color": {"text": "var:preset|color|brand-dark"}}
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "var:preset|color|brand",
          "style": "solid",
          "width": "0 0 0 5px"
        },
        "color": {"background": "var:preset|color|brand-soft"},
        "spacing": {"padding": "var:preset|spacing|50"}
      },
      "core/table": {
        "border": {"color": "var:preset|color|divider"},
        "typography": {"fontSize": "0.95rem"}
      },
      "core/search": {
        "border": {"radius": "10px"}
      }
    }
  },
  "customTemplates": [
    {
      "name": "poultry-hub",
      "title": "Poultry Type Hub",
      "postTypes": ["page"]
    },
    {
      "name": "section-hub",
      "title": "Editorial Section Hub",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    {"area": "header", "name": "header", "title": "Header"},
    {"area": "footer", "name": "footer", "title": "Footer"}
  ]
}
